# 이 파일은 예시입니다. 실제 값은 Vercel 대시보드 > Settings > Environment Variables 에 등록하세요.
ANTHROPIC_API_KEY=sk-ant-your-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=never-put-this-in-the-client

# GitHub Pages에서 AI API를 연결할 때만 필요합니다.
VITE_PLAN_API_URL=https://your-vercel-project.vercel.app/api/plan
VITE_SUMMARY_API_URL=https://your-vercel-project.vercel.app/api/plan
VITE_VISION_API_URL=https://your-vercel-project.vercel.app/api/vision
VITE_DELETE_ACCOUNT_API_URL=https://your-vercel-project.vercel.app/api/delete-account
