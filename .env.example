# 이 파일은 예시입니다. 실제 값은 Vercel 대시보드 > Settings > Environment Variables 에 등록하세요.
# 이 파일에 진짜 키를 적어서 GitHub에 올리지 마세요.

# [필수] Google AI Studio에서 받은 Gemini 키 (서버에서만 사용)
GEMINI_API_KEY=your-google-ai-studio-key

# [선택] 비워두면 gemini-3.5-flash-lite → gemini-3.1-flash-lite → gemini-2.5-flash-lite 순서로 자동 사용
GEMINI_MODEL=

# [선택] 회원탈퇴 기능용 (서비스 키는 절대 프론트엔드에 넣지 마세요)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=never-put-this-in-the-client

# [선택] Vercel 주소가 아닌 다른 곳(예: GitHub Pages)에서 AI API를 부를 때 허용할 주소, 쉼표로 구분
# https://happyeonse05.github.io 는 기본으로 허용돼 있어요.
ALLOWED_ORIGINS=

# GitHub Pages에서 앱 화면을 띄우고 AI는 Vercel API를 쓸 때만 필요합니다. (Vercel만 쓰면 비워두세요)
VITE_PLAN_API_URL=https://your-vercel-project.vercel.app/api/plan
VITE_SUMMARY_API_URL=https://your-vercel-project.vercel.app/api/plan
VITE_VISION_API_URL=https://your-vercel-project.vercel.app/api/vision
VITE_DELETE_ACCOUNT_API_URL=https://your-vercel-project.vercel.app/api/delete-account
